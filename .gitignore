/.idea/

# Our shared scratchpad file: I overwrite it with each new code snippet,
# you copy it by hand into the real project file. It never needs to be
# tracked in git — only the real files under src/ and tests/ do.
/CODE_TO_BE_REWRITTEN.py

# Standard Python junk.
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
